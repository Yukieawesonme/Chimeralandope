{
  "version": "1.0.0",
  "description": "Asset Manifest for ChimeraLand - Maps public library assets to game roles with normalization metadata",
  "libraries": {
    "Sketchfab": {
      "baseUrl": "https://api.sketchfab.com/v3/models",
      "licenseFilter": ["CC-BY", "CC-BY-SA", "CC0", "GPL", "Standard"],
      "format": "glb",
      "notes": "Requires API key for download. Use manual download for now, place in assets/models/sketchfab/"
    },
    "PolyHaven": {
      "baseUrl": "https://api.polyhaven.com",
      "licenseFilter": ["CC0"],
      "format": "glb",
      "downloadPattern": "https://dl.polyhaven.org/file/ph-assets/Models/{id}/glb/{id}.glb",
      "texturePattern": "https://dl.polyhaven.org/file/ph-assets/Textures/{id}/{res}/{id}_{map}_{res}.{ext}",
      "notes": "Fully open CC0. Excellent for PBR terrain materials and environment props."
    },
    "ambientCG": {
      "baseUrl": "https://ambientcg.com/api/v2",
      "licenseFilter": ["CC0"],
      "format": "glb",
      "downloadPattern": "https://cdn.ambientcg.com/resources/{id}/{id}_{res}_{map}.{ext}",
      "notes": "Best for PBR texture sets (Albedo, Normal, Roughness, Metalness, AO, Height). No models, only materials."
    },
    "Quaternius": {
      "baseUrl": "https://quaternius.com",
      "licenseFilter": ["CC0", "CC-BY"],
      "format": "glb",
      "downloadPattern": "https://github.com/Quaternius/3D-Models/raw/main/{category}/{model}/{model}.glb",
      "notes": "Excellent low-poly creatures, characters, modular props. Ready for games."
    },
    "Kenney": {
      "baseUrl": "https://kenney.nl/assets",
      "licenseFilter": ["CC0"],
      "format": "glb",
      "notes": "Prototyping assets. Good for building pieces, simple props, UI elements."
    },
    "OpenGameArt": {
      "baseUrl": "https://opengameart.org",
      "licenseFilter": ["CC0", "CC-BY", "CC-BY-SA", "GPL"],
      "format": ["glb", "fbx", "obj"],
      "notes": "Community submissions. Quality varies. Check licenses individually."
    }
  },
